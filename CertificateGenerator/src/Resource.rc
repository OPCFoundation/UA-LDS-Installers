// Win32 resource script for Opc.Ua.CertificateGenerator.exe
//
// Reproduces the legacy VERSIONINFO block so the shipped binary keeps its
// identity in Explorer's Details tab, in Authenticode signature dialogs, and
// for anything that inspects file version metadata.
//
// Version numbers and identity strings come from version.h - do not hard-code
// them here.  The legacy Resource.rc did, which is how it ended up disagreeing
// with Version.h and BuildVersion.h.

#include "resource.h"
#include "version.h"

#include <winresrc.h>

/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CERTGEN_VERSION
 PRODUCTVERSION CERTGEN_VERSION
 FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      CERTGEN_COMPANY_NAME
            VALUE "FileDescription",  CERTGEN_FILE_DESCRIPTION
            VALUE "FileVersion",      CERTGEN_VERSION_STR
            VALUE "InternalName",     CERTGEN_INTERNAL_NAME
            VALUE "LegalCopyright",   CERTGEN_LEGAL_COPYRIGHT
            VALUE "LegalTrademarks",  CERTGEN_LEGAL_TRADEMARKS
            VALUE "OriginalFilename", CERTGEN_ORIGINAL_FILENAME
            VALUE "ProductName",      CERTGEN_PRODUCT_NAME
            VALUE "ProductVersion",   CERTGEN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#endif    // English (United States) resources
/////////////////////////////////////////////////////////////////////////////
